  "attractions": [
    {
      "name": "夫子庙|秦淮文化核心地标",
      "x": 588.1,
      "y": 674.2,
      "r": 13,
      "description": "夫子庙始建于东晋，是中国四大文庙之一，也是南京历史文化的重要象征。历经千年发展，这里融合儒家文化、秦淮民俗与商业传统，以古建筑群、贡院文化和十里秦淮闻名，展现南京深厚的人文底蕴。",
      "icon": "assets/attraction-icons/fuzimiao.png"
